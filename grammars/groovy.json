{
  "name": "Groovy",
  "scopeName": "source.groovy",
  "type": "tree-sitter",
  "parser": "tree-sitter-groovy",
  "injectionNames": ["groovy"],
  "fileTypes": ["groovy", "gradle", "gvy", "jenkinsfile", "Jenkinsfile"],
  "comments": {
    "start": "/ "
  },
  "treeSitter": {
    // Pin a tag or a full SHA, never a branch. Verify the ref is on the main
    // line before trusting it — `gh api repos/OWNER/REPO/compare/<ref>...HEAD`
    // reporting `diverged` or a nonzero `behind` means it is not.
    "parserSource": "github:murtaza64/tree-sitter-groovy#initial",
    "wasmBuildTool": "tree-sitter-cli#v0.26.13",
    "grammar": "groovy.wasm",
    "highlightsQuery": "groovy-highlights.scm",
    "localsQuery": "groovy-locals.scm",
    "foldsQuery": "groovy-folds.scm"
  }
}
